{
  "$schema": "../../schema/viasat-server.schema.json",
  "name": "io.viasat/blackduck-mcp-server",
  "title": "Black Duck MCP Server",
  "description": "Query Black Duck projects, BOMs, components, vulnerabilities, scans, and users via MCP tools.",
  "version": "0.1.0",
  "source": "viasat",
  "hosting": "Remote",
  "websiteUrl": "https://<host>/",
  "mcpServerCardUrl": "https://<host>/.well-known/mcp/server-card.json",
  "repository": {
    "url": "https://git.viasat.com/seceng-devsecops-platform/agentic-cybersecurity-supply-chain-agent",
    "source": "gitlab"
  },
  "owner": {
    "team": "TBD",
    "email": "TBD",
    "slack": "TBD"
  },
  "governanceReview": {
    "status": "Not Approved"
  },
  "support": {
    "documentation": "https://<host>/"
  },
  "transports": [
    {
      "type": "streamable-http",
      "url": "https://<host>/mcp"
    }
  ],
  "auth": {
    "type": "oauth2",
    "authorizationServerUrl": "https://<host>",
    "description": "OAuth2-compatible flow. Hosted login collects a Black Duck API token and returns an encrypted bearer token for /mcp."
  }
}
